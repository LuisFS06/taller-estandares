<script>
(function(){
  var slides = Array.prototype.slice.call(document.querySelectorAll('.slide'));
  var i = 0;
  var phases = [
    {k:'Inicio', w:5},
    {k:'Crear', w:12},
    {k:'Romper', w:10},
    {k:'Entender', w:5},
    {k:'Arreglar', w:10},
    {k:'Validar', w:12},
    {k:'Prueba', w:6},
    {k:'Escalar', w:8}
  ];
  var segsEl = document.getElementById('segs');
  phases.forEach(function(p){
    var d = document.createElement('div');
    d.className = 'seg';
    d.style.flex = p.w;
    d.innerHTML = '<span>' + p.k + '</span>';
    segsEl.appendChild(d);
  });
  var segs = Array.prototype.slice.call(segsEl.children);

  function pad(n){ return (n<10?'0':'') + n; }

  function show(n){
    i = Math.max(0, Math.min(slides.length-1, n));
    slides.forEach(function(s,idx){ s.classList.toggle('active', idx===i); });
    slides[i].scrollTop = 0;
    var ph = parseInt(slides[i].dataset.phase, 10) || 0;
    segs.forEach(function(s,idx){
      s.classList.toggle('on', idx===ph);
      s.classList.toggle('done', idx<ph);
    });
    document.getElementById('count').textContent = pad(i+1) + ' / ' + pad(slides.length);
    document.getElementById('railnum').textContent = pad(i+1);
  }

  document.getElementById('next').addEventListener('click', function(){ show(i+1); });
  document.getElementById('prev').addEventListener('click', function(){ show(i-1); });

  document.addEventListener('keydown', function(e){
    var t = e.target.tagName;
    if(t === 'BUTTON') return;
    if(e.key==='ArrowRight'||e.key==='PageDown'||e.key===' '){ e.preventDefault(); show(i+1); }
    if(e.key==='ArrowLeft'||e.key==='PageUp'){ e.preventDefault(); show(i-1); }
    if(e.key==='Home'){ show(0); }
    if(e.key==='End'){ show(slides.length-1); }
  });

  var x0 = null;
  document.addEventListener('touchstart', function(e){ x0 = e.touches[0].clientX; }, {passive:true});
  document.addEventListener('touchend', function(e){
    if(x0===null) return;
    var dx = e.changedTouches[0].clientX - x0;
    if(Math.abs(dx) > 60){ show(dx < 0 ? i+1 : i-1); }
    x0 = null;
  }, {passive:true});

  /* checklist */
  document.querySelectorAll('.check-item').forEach(function(item){
    item.addEventListener('click', function(){ item.classList.toggle('checked'); });
  });

  /* timers */
  document.querySelectorAll('.timer').forEach(function(timer){
    var duration = parseInt(timer.dataset.duration, 10);
    var remaining = duration;
    var display = timer.querySelector('.timer-display');
    var toggleBtn = timer.querySelector('[data-action="toggle"]');
    var resetBtn = timer.querySelector('[data-action="reset"]');
    var interval = null;

    function fmt(sec){
      var m = Math.floor(sec/60), s = sec%60;
      return String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
    }
    function tick(){
      remaining--;
      if(remaining <= 0){
        remaining = 0;
        clearInterval(interval); interval = null;
        toggleBtn.textContent = 'Iniciar';
        timer.classList.add('done');
      }
      display.textContent = fmt(remaining);
    }
    toggleBtn.addEventListener('click', function(){
      if(interval){
        clearInterval(interval); interval = null;
        toggleBtn.textContent = 'Reanudar';
      } else {
        if(remaining <= 0) return;
        timer.classList.remove('done');
        interval = setInterval(tick, 1000);
        toggleBtn.textContent = 'Pausar';
      }
    });
    resetBtn.addEventListener('click', function(){
      clearInterval(interval); interval = null;
      remaining = duration;
      display.textContent = fmt(remaining);
      toggleBtn.textContent = 'Iniciar';
      timer.classList.remove('done');
    });
  });

  show(0);
})();
</script>
