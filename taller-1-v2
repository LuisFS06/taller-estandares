    var resetBtn = timer.querySelector('[data-action="reset"]');
    var interval = null;

    function fmt(sec){ var m = Math.floor(sec/60), s = sec%60; return String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0'); }
    function tick(){
      remaining--;
      if(remaining <= 0){
        remaining = 0; clearInterval(interval); interval = null;
        toggleBtn.textContent = 'Iniciar'; timer.classList.add('done');
      }
      display.textContent = fmt(remaining);
    }
    toggleBtn.addEventListener('click', function(){
      if(interval){ clearInterval(interval); interval = null; toggleBtn.textContent = 'Reanudar'; }
      else {
        if(remaining <= 0) return;
        timer.classList.remove('done');
        interval = setInterval(tick, 1000);
        toggleBtn.textContent = 'Pausar';
      }
    });
    resetBtn.addEventListener('click', function(){
      clearInterval(interval); interval = null;
      remaining = duration; display.textContent = fmt(remaining);
      toggleBtn.textContent = 'Iniciar'; timer.classList.remove('done');
    });
  });
})();
</script>

</body>
</html>
