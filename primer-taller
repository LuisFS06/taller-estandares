<script>
(function(){
  var slides = Array.prototype.slice.call(document.querySelectorAll('.slide'));
  var total = slides.length;
  var current = 0;

  var progressFill = document.getElementById('progressFill');
  var sectionLabel = document.getElementById('sectionLabel');
  var slideNum = document.getElementById('slideNum');
  var slideTotal = document.getElementById('slideTotal');
  var navDots = document.getElementById('navDots');
  var prevBtn = document.getElementById('prevBtn');
  var nextBtn = document.getElementById('nextBtn');

  slideTotal.textContent = String(total).padStart(2,'0');

  slides.forEach(function(s, i){
    var dot = document.createElement('div');
    dot.className = 'd';
    dot.addEventListener('click', function(){ goTo(i); });
    navDots.appendChild(dot);
  });
  var dots = Array.prototype.slice.call(navDots.children);

  function render(){
    slides.forEach(function(s, i){
      s.classList.toggle('active', i === current);
    });
    dots.forEach(function(d, i){ d.classList.toggle('on', i === current); });
    progressFill.style.width = ((current+1)/total*100) + '%';
    slideNum.textContent = String(current+1).padStart(2,'0');
    sectionLabel.innerHTML = '<b>' + slides[current].dataset.section + '</b>';
    prevBtn.disabled = current === 0;
    nextBtn.disabled = current === total - 1;
  }

  function goTo(i){
    if(i < 0 || i >= total) return;
    current = i;
    render();
  }

  prevBtn.addEventListener('click', function(){ goTo(current - 1); });
  nextBtn.addEventListener('click', function(){ goTo(current + 1); });

  document.addEventListener('keydown', function(e){
    if(e.key === 'ArrowRight' || e.key === ' '){ e.preventDefault(); goTo(current + 1); }
    if(e.key === 'ArrowLeft'){ e.preventDefault(); goTo(current - 1); }
  });

  render();

  /* ---- before/after code toggles ---- */
  document.querySelectorAll('.status-toggle').forEach(function(toggle){
    var group = toggle.dataset.group;
    var buttons = toggle.querySelectorAll('button');
    var label = document.querySelector('[data-status="' + group + '"]');
    var annot = document.getElementById(group + '-annot');
    var beforeLabelHTML = label ? label.innerHTML : '';

    buttons.forEach(function(btn){
      btn.addEventListener('click', function(){
        buttons.forEach(function(b){ b.classList.remove('active'); });
        btn.classList.add('active');

        var card = btn.closest('.code-card');
        card.querySelectorAll('.code-pane').forEach(function(p){ p.classList.remove('visible'); });
        document.getElementById(btn.dataset.target).classList.add('visible');

        var isAfter = btn.classList.contains('after');
        var statusEl = card.querySelector('.status-label');
        if(statusEl){
          statusEl.innerHTML = isAfter ? '<span class="live-green">● unificado / estable</span>' : beforeLabelHTML;
        }
        if(annot){
          var textSpan = annot.querySelector('span:last-child');
          if(textSpan){ textSpan.innerHTML = isAfter ? annot.dataset.after : annot.dataset.before; }
        }
      });
    });
  });

  /* ---- checklist toggles ---- */
  document.querySelectorAll('.check-item').forEach(function(item){
    item.addEventListener('click', function(){
      item.classList.toggle('checked');
    });
  });

  /* ---- exercise timers ---- */
  document.querySelectorAll('.timer').forEach(function(timer){
    var duration = parseInt(timer.dataset.duration, 10);
    var remaining = duration;
    var display = timer.querySelector('.timer-display');
    var toggleBtn = timer.querySelector('[data-action="toggle"]');
    var resetBtn = timer.querySelector('[data-action="reset"]');
    var interval = null;

    function fmt(sec){
      var m = Math.floor(sec/60), s = sec%60;
      return String(m).padStart(2,'0') + ':' + String(s).padStart(2,'0');
    }
    function tick(){
      remaining--;
      if(remaining <= 0){
        remaining = 0;
        clearInterval(interval); interval = null;
        toggleBtn.textContent = 'Iniciar';
        timer.classList.add('done');
      }
      display.textContent = fmt(remaining);
    }
    toggleBtn.addEventListener('click', function(){
      if(interval){
        clearInterval(interval); interval = null;
        toggleBtn.textContent = 'Reanudar';
      } else {
        if(remaining <= 0) return;
        timer.classList.remove('done');
        interval = setInterval(tick, 1000);
        toggleBtn.textContent = 'Pausar';
      }
    });
    resetBtn.addEventListener('click', function(){
      clearInterval(interval); interval = null;
      remaining = duration;
      display.textContent = fmt(remaining);
      toggleBtn.textContent = 'Iniciar';
      timer.classList.remove('done');
    });
  });
})();
</script>

